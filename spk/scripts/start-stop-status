#!/bin/sh

SERVICE_NAME="netbird"

# Default PKGVAR/PKGDEST so the script also works when invoked outside the
# synopkg framework (e.g. a DSM Task Scheduler task running as root — see
# the "Advanced: kernel TUN" section in the README).
PKGVAR="${SYNOPKG_PKGVAR:-/var/packages/netbird/var}"
PKGDEST="${SYNOPKG_PKGDEST:-/var/packages/netbird/target}"

PID_FILE="${PKGVAR}/netbird.pid"
LOG_FILE="${PKGVAR}/netbird.log"
CONFIG_FILE="${PKGVAR}/config.json"
SOCKET_FILE="${PKGVAR}/netbird.sock"
DAEMON_ADDR="unix://${SOCKET_FILE}"

# NetBird bundles wireguard-go, so kernel WireGuard is never needed.
export NB_WG_KERNEL_DISABLED=true

# Keep all state inside the package var directory so uninstall is clean and
# we never touch /var/lib/netbird or /var/run.
export NB_STATE_DIR="${PKGVAR}"
export NB_CONFIG="${CONFIG_FILE}"
export NB_DAEMON_ADDR="${DAEMON_ADDR}"
export HOME="${PKGVAR}"

configure_networking() {
    # Package Center runs us as the unprivileged package user. A writable
    # /dev/net/tun alone does not grant CAP_NET_ADMIN, so always use netstack
    # unless explicitly started as root via the optional Task Scheduler path.
    export NB_USE_NETSTACK_MODE=true
    NETWORK_MODE="netstack with local forwarding"

    if [ "$(id -u)" -eq 0 ]; then
        if ! lsmod 2>/dev/null | grep -q "^tun "; then
            modprobe tun 2>/dev/null || insmod /lib/modules/tun.ko 2>/dev/null || true
        fi
        if [ ! -c /dev/net/tun ]; then
            [ -d /dev/net ] || mkdir -m 755 /dev/net 2>/dev/null
            mknod /dev/net/tun c 10 200 2>/dev/null
        fi
        if [ -c /dev/net/tun ] && [ -w /dev/net/tun ]; then
            export NB_USE_NETSTACK_MODE=false
            NETWORK_MODE="kernel TUN"
        fi
    fi

    if [ "${NB_USE_NETSTACK_MODE}" = true ]; then
        # Match upstream's rootless image: forward permitted inbound traffic
        # on the NetBird IP to host loopback listeners (DSM, SSH, SMB, etc.).
        # NetBird access policies still apply, including to loopback-only apps.
        export NB_ENABLE_NETSTACK_LOCAL_FORWARDING=true
        export NB_DISABLE_DNS=true
        export NB_ENABLE_CAPTURE=false
    fi
}

start_daemon() {
    # Ensure var directory is writable
    mkdir -p "${PKGVAR}"

    # Ensure binary and CLI wrapper are executable
    chmod +x "${PKGDEST}/bin/netbird.bin" "${PKGDEST}/bin/netbird" 2>/dev/null

    configure_networking
    echo "$(date) Starting ${SERVICE_NAME} (${NETWORK_MODE})..." >>"${LOG_FILE}"

    nohup "${PKGDEST}/bin/netbird.bin" service run \
        --config "${CONFIG_FILE}" \
        --log-file "${LOG_FILE}" \
        --log-level info \
        --daemon-addr "${DAEMON_ADDR}" \
        >>"${LOG_FILE}" 2>&1 &

    echo $! >"${PID_FILE}"

    # Give the daemon a moment to start (or crash)
    sleep 2

    if daemon_status; then
        echo "$(date) ${SERVICE_NAME} started successfully (PID=$(cat "${PID_FILE}"))" >>"${LOG_FILE}"
        return 0
    else
        echo "$(date) ${SERVICE_NAME} failed to start" >>"${LOG_FILE}"
        # Surface the daemon's last output to syslog so the failure reason
        # appears in journald alongside DSM's generic "Failed to run script".
        tail -n 20 "${LOG_FILE}" 2>/dev/null | logger -t netbird-pkg
        rm -f "${PID_FILE}"
        return 1
    fi
}

stop_daemon() {
    if [ -r "${PID_FILE}" ]; then
        PID=$(cat "${PID_FILE}")
        echo "$(date) Stopping ${SERVICE_NAME} PID=${PID}" >>"${LOG_FILE}"
        kill -TERM "${PID}" 2>/dev/null
        wait_for_status 1 || kill -KILL "${PID}" 2>/dev/null
        rm -f "${PID_FILE}"
    fi
}

daemon_status() {
    if [ -r "${PID_FILE}" ]; then
        PID=$(cat "${PID_FILE}")
        # /proc check instead of `kill -0` to avoid DSM's BASH_ERR logger
        # noisily reporting "No such process" when the daemon has exited.
        if [ -n "${PID}" ] && [ -d "/proc/${PID}" ]; then
            return 0
        fi
        rm -f "${PID_FILE}"
    fi
    return 1
}

wait_for_status() {
    counter=20
    while [ ${counter} -gt 0 ]; do
        daemon_status
        [ $? -eq "$1" ] && return 0
        counter=$((counter - 1))
        sleep 1
    done
    return 1
}

case "$1" in
start)
    if daemon_status; then
        exit 0
    fi
    start_daemon
    exit $?
    ;;
stop)
    if daemon_status; then
        stop_daemon
    fi
    exit 0
    ;;
status)
    if daemon_status; then
        exit 0
    else
        exit 3
    fi
    ;;
esac
