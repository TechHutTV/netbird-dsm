#!/bin/sh

SERVICE_NAME="netbird"

PKGVAR="${SYNOPKG_PKGVAR}"
PKGDEST="${SYNOPKG_PKGDEST}"

PID_FILE="${PKGVAR}/netbird.pid"
LOG_FILE="${PKGVAR}/netbird.log"
CONFIG_FILE="${PKGVAR}/config.json"
SOCKET_FILE="${PKGVAR}/netbird.sock"
DAEMON_ADDR="unix://${SOCKET_FILE}"

# NetBird bundles wireguard-go, so kernel WireGuard is never needed.
export NB_WG_KERNEL_DISABLED=true

# Keep all state inside the package var directory so uninstall is clean and
# we never touch /var/lib/netbird or /var/run.
export NB_STATE_DIR="${PKGVAR}"
export NB_CONFIG="${CONFIG_FILE}"
export NB_DAEMON_ADDR="${DAEMON_ADDR}"
export HOME="${PKGVAR}"

start_daemon() {
    # Ensure var directory is writable
    mkdir -p "${PKGVAR}"

    # Ensure binary and CLI wrapper are executable
    chmod +x "${PKGDEST}/bin/netbird.bin" "${PKGDEST}/bin/netbird" 2>/dev/null

    ensure_tun_created

    # Prefer a real kernel TUN device so DSM services (sshd, web UI) are
    # reachable on the peer's NetBird IP. The daemon runs as the `netbird`
    # package user with CAP_NET_ADMIN granted via setcap in postinst, so it
    # needs /dev/net/tun to be openable by that user. Fall back to netstack
    # only when the device can't be opened — in netstack mode the host is
    # NOT reachable on its NetBird IP, only outbound peer traffic works.
    if [ ! -c /dev/net/tun ] || [ ! -w /dev/net/tun ]; then
        export NB_USE_NETSTACK_MODE=true
        echo "$(date) /dev/net/tun unavailable or not writable by $(id -un), falling back to netstack mode (host services will not be reachable on the NetBird IP)" >>"${LOG_FILE}"
    fi

    echo "$(date) Starting ${SERVICE_NAME}..." >>"${LOG_FILE}"

    nohup "${PKGDEST}/bin/netbird.bin" service run \
        --config "${CONFIG_FILE}" \
        --log-file "${LOG_FILE}" \
        --log-level info \
        --daemon-addr "${DAEMON_ADDR}" \
        >>"${LOG_FILE}" 2>&1 &

    echo $! >"${PID_FILE}"

    # Give the daemon a moment to start (or crash)
    sleep 2

    if daemon_status; then
        echo "$(date) ${SERVICE_NAME} started successfully (PID=$(cat "${PID_FILE}"))" >>"${LOG_FILE}"
        return 0
    else
        echo "$(date) ${SERVICE_NAME} failed to start" >>"${LOG_FILE}"
        # Surface the daemon's last output to syslog so the failure reason
        # appears in journald alongside DSM's generic "Failed to run script".
        tail -n 20 "${LOG_FILE}" 2>/dev/null | logger -t netbird-pkg
        rm -f "${PID_FILE}"
        return 1
    fi
}

stop_daemon() {
    if [ -r "${PID_FILE}" ]; then
        PID=$(cat "${PID_FILE}")
        echo "$(date) Stopping ${SERVICE_NAME} PID=${PID}" >>"${LOG_FILE}"
        kill -TERM "${PID}" 2>/dev/null
        wait_for_status 1 || kill -KILL "${PID}" 2>/dev/null
        rm -f "${PID_FILE}"
    fi
}

daemon_status() {
    if [ -r "${PID_FILE}" ]; then
        PID=$(cat "${PID_FILE}")
        # /proc check instead of `kill -0` to avoid DSM's BASH_ERR logger
        # noisily reporting "No such process" when the daemon has exited.
        if [ -n "${PID}" ] && [ -d "/proc/${PID}" ]; then
            return 0
        fi
        rm -f "${PID_FILE}"
    fi
    return 1
}

wait_for_status() {
    counter=20
    while [ ${counter} -gt 0 ]; do
        daemon_status
        [ $? -eq "$1" ] && return 0
        counter=$((counter - 1))
        sleep 1
    done
    return 1
}

ensure_tun_created() {
    # All of these will silently no-op when this script is running as the
    # unprivileged `netbird` user (the package user from privilege.conf) —
    # postinst already handled them with root. They only do real work when
    # DSM happens to invoke this script as root, or as a recovery path if
    # the device was wiped after postinst.
    if ! lsmod 2>/dev/null | grep -q "^tun "; then
        modprobe tun 2>/dev/null || insmod /lib/modules/tun.ko 2>/dev/null || true
    fi
    if [ ! -c /dev/net/tun ]; then
        [ -d /dev/net ] || mkdir -m 755 /dev/net 2>/dev/null
        mknod /dev/net/tun c 10 200 2>/dev/null
    fi
    # Make sure the netbird user can open it. Across reboots devtmpfs may
    # recreate the node with default 0600 perms, so always try.
    chmod 0666 /dev/net/tun 2>/dev/null
}

case "$1" in
start)
    if daemon_status; then
        exit 0
    fi
    start_daemon
    exit $?
    ;;
stop)
    if daemon_status; then
        stop_daemon
    fi
    exit 0
    ;;
status)
    if daemon_status; then
        exit 0
    else
        exit 3
    fi
    ;;
esac
