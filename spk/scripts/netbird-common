#!/bin/sh
# Shared by preinst and start-stop-status. These checks run as the package user.

package_error() {
    printf 'NetBird: %s\n' "$*" >&2
    printf 'NetBird: %s\n' "$*" | logger -t netbird-pkg 2>/dev/null || :
    # Reporting must still work if either destination is inaccessible. The
    # subshells contain shell redirection errors (including on DSM's ash).
    if [ -n "${SYNOPKG_TEMP_LOGFILE:-}" ]; then
        (printf 'NetBird: %s\n' "$*" >"${SYNOPKG_TEMP_LOGFILE}") 2>/dev/null || :
    fi
    if [ -n "${LOG_FILE:-}" ] && { [ ! -e "$LOG_FILE" ] || [ -f "$LOG_FILE" ]; }; then
        (umask 077; printf 'NetBird: %s\n' "$*" >>"$LOG_FILE") 2>/dev/null || :
    fi
    return 1
}

package_recovery_error() (
    state_dir=$(readlink -f "$PKGVAR" 2>/dev/null)
    package_error "$* If NetBird was started as root, disable its Task Scheduler task, stop the daemon as root, then restore netbird:netbird ownership of ${state_dir:-$PKGVAR}. See 'Returning to Package Center' in the README. Keep the existing configuration and enrollment."
)

# Identify this package's invocation, including a root daemon whose exe link
# DSM hides from the package user. Never treat an arbitrary PID as our daemon.
# Return 2 when a NetBird process cannot be inspected safely.
package_daemon_matches() (
    proc=$1
    if ! IFS= read -r name 2>/dev/null <"$proc/comm"; then
        [ -d "$proc" ] && return 2
        return 1
    fi
    case "$name" in netbird|netbird.bin) ;; *) return 1 ;; esac
    args=$(tr '\000' ' ' 2>/dev/null <"$proc/cmdline") || return 2
    case "$args" in *" service run "*) ;; *) return 1 ;; esac
    exe=$(readlink "$proc/exe" 2>/dev/null)
    exe=${exe% (deleted)}
    command=${args%% *}
    package_bin=$(readlink -f "${PKGDEST}/bin/netbird.bin")
    package_var=$(readlink -f "$PKGVAR")
    if { [ -n "$package_bin" ] && { [ "$exe" = "$package_bin" ] || [ "$command" = "$package_bin" ]; }; } ||
       [ "$command" = "${PKGDEST}/bin/netbird.bin" ] ||
       [ "$command" = /var/packages/netbird/target/bin/netbird.bin ]; then
        case "$args" in
            *" --config ${PKGVAR}/config.json "*|*" --config ${package_var}/config.json "*|*" --config /var/packages/netbird/var/config.json "*)
                case "$args" in
                    *" --daemon-addr unix://${PKGVAR}/netbird.sock "*|*" --daemon-addr unix://${package_var}/netbird.sock "*|*" --daemon-addr unix:///var/packages/netbird/var/netbird.sock "*) return 0 ;;
                esac
                ;;
        esac
    fi
    return 1
)

check_manual_install() (
    package_wrapper=$(readlink -f "${PKGDEST}/bin/netbird")
    conflicts=""

    # The package itself installs this link. A different target or a regular
    # file would collide with DSM's usr-local-linker, even if no daemon runs.
    if [ -e /usr/local/bin/netbird ] || [ -L /usr/local/bin/netbird ]; then
        cli_target=$(readlink -f /usr/local/bin/netbird)
        cli_link=$(readlink /usr/local/bin/netbird)
        if [ "$cli_link" != /var/packages/netbird/target/bin/netbird ] &&
           { [ -z "$package_wrapper" ] || [ "$cli_target" != "$package_wrapper" ]; }; then
            conflicts="${conflicts}
  /usr/local/bin/netbird belongs to another installation"
        fi
    fi

    for proc in /proc/[0-9]*; do
        [ -r "$proc/comm" ] || continue
        IFS= read -r name <"$proc/comm" || continue
        case "$name" in netbird|netbird.bin) ;; *) continue ;; esac
        # cmdline remains useful when the executable was deleted, or when
        # DSM denies the package user access to a root process's exe link.
        args=$(tr '\000' ' ' 2>/dev/null <"$proc/cmdline") || continue
        case "$args" in *" service run "*) ;; *) continue ;; esac
        package_daemon_matches "$proc" && continue
        conflicts="${conflicts}
  another NetBird daemon is running (PID ${proc##*/})"
    done

    # The DSM unit is pkgctl-netbird.service, not the manual netbird.service.
    # A disabled, inactive unit is a remnant, not an active conflict.
    if command -v systemctl >/dev/null 2>&1; then
        enabled=$(systemctl is-enabled netbird.service 2>/dev/null)
        case "$enabled" in enabled|enabled-runtime) autostart=true ;; *) autostart=false ;; esac
        if systemctl is-active --quiet netbird.service 2>/dev/null || "$autostart"; then
            conflicts="${conflicts}
  the manual netbird.service is active or enabled"
        fi
    fi

    if [ -n "$conflicts" ]; then
        package_error "A manual installation conflicts with this package:${conflicts}
Stop its daemon and disable its startup service/task, then remove only its confirmed CLI binary/link. See the README section 'Replacing a manual installation'."
        return 1
    fi

    # Configs, stale sockets, inactive units and wt0 alone do not prove that
    # another installation is active. Never delete them or import implicitly.
    if [ -d /etc/netbird ] || [ -d /var/lib/netbird ] || [ -S /var/run/netbird.sock ]; then
        echo "NetBird: legacy state found; existing package config is preserved and fresh package state uses a new enrollment. See 'Replacing a manual installation' in the README." >&2
    fi
)

# Check profile/state files as well as the default config. Do not traverse
# directory symlinks or inspect historical logs; neither is daemon state that
# ownership recovery should silently change outside the package directory.
check_package_state_access() (
    state_dir=${1:-$PKGVAR}
    [ -e "$state_dir" ] || [ -L "$state_dir" ] || return 0
    if [ ! -d "$state_dir" ] || [ ! -r "$state_dir" ] ||
       [ ! -w "$state_dir" ] || [ ! -x "$state_dir" ]; then
        package_recovery_error "Cannot access the package state directory ${state_dir}."
        return 1
    fi
    for entry in "$state_dir"/* "$state_dir"/.[!.]* "$state_dir"/..?*; do
        [ -e "$entry" ] || [ -L "$entry" ] || continue
        case "${entry##*/}" in
            netbird.log|netbird.pid|netbird.log.*|netbird-*.log*|.config-init.*) continue ;;
        esac
        if [ -d "$entry" ]; then
            if [ -L "$entry" ]; then
                package_recovery_error "Cannot verify state through directory symlink ${entry}. Check its target with an administrator."
                return 1
            fi
            check_package_state_access "$entry" || return 1
        elif [ -f "$entry" ] || [ -L "$entry" ]; then
            if [ ! -r "$entry" ] || [ ! -w "$entry" ]; then
                package_recovery_error "Cannot read or update package state file ${entry}."
                return 1
            fi
        fi
    done
)

prepare_package_config() (
    if ! mkdir -p "${PKGVAR}" || [ ! -r "${PKGVAR}" ] ||
       [ ! -w "${PKGVAR}" ] || [ ! -x "${PKGVAR}" ]; then
        package_recovery_error "Cannot access the package state directory ${PKGVAR}. Restore package-user access before starting."
        return 1
    fi

    if [ -e "${CONFIG_FILE}" ] || [ -L "${CONFIG_FILE}" ]; then
        if [ ! -f "${CONFIG_FILE}" ] || [ ! -r "${CONFIG_FILE}" ] ||
           [ ! -w "${CONFIG_FILE}" ] || [ ! -s "${CONFIG_FILE}" ]; then
            package_recovery_error "Existing package config ${CONFIG_FILE} is empty, invalid as a file, or inaccessible. Restore it from backup or repair package-user permissions; it will not be replaced."
            return 1
        fi
        return 0
    fi

    # Missing config alongside profile/state data is not a fresh installation.
    # Allow only launcher diagnostics/runtime files and interrupted seed files.
    for entry in "${PKGVAR}"/* "${PKGVAR}"/.[!.]* "${PKGVAR}"/..?*; do
        [ -e "$entry" ] || [ -L "$entry" ] || continue
        case "${entry##*/}" in
            netbird.log|netbird.log.*|netbird.pid|netbird.sock|.config-init.*) continue ;;
        esac
        package_error "Package config is missing but state remains in ${PKGVAR}. Restore config.json from backup or follow the documented clean reset; refusing to create a new identity."
        return 1
    done

    umask 077
    seed=$(mktemp "${PKGVAR}/.config-init.XXXXXX") || {
        package_error "Cannot create initial package configuration in ${PKGVAR}."
        return 1
    }
    trap 'rm -f "$seed"' EXIT
    trap 'exit 1' HUP INT TERM
    # Match createNewConfig in the pinned NetBird release. {} takes the
    # existing-config path upstream and enables its legacy SSH default.
    printf '%s\n' '{"ServerSSHAllowed":false,"RemoteJobsAllowed":false,"WgPort":51820}' >"$seed" || return 1
    # Hard-link a complete seed atomically without replacing any existing
    # destination. -T also refuses a directory created concurrently.
    if ! ln -T "$seed" "${CONFIG_FILE}" 2>/dev/null; then
        package_error "Initial package config could not be installed without overwriting existing state. Check ${CONFIG_FILE} and retry."
        return 1
    fi
)
